//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        HRM_L: HRM_L {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            require-prior-idle-ms = <175>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 35 36 37>;
            hold-trigger-on-release;
        };

        HRM_R: HRM_R {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            require-prior-idle-ms = <175>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34>;
        };
    };

    combos {
        compatible = "zmk,combos";

        COMBO_BS {
            bindings = <&kp BACKSPACE>;
            key-positions = <6 7>;
        };

        COMBO_DEL {
            bindings = <&kp DEL>;
            key-positions = <2 3>;
        };

        COMBO_TAB {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        COMBO_ESC {
            bindings = <&kp ESC>;
            key-positions = <12 13>;
        };

        COMBO_L_PARAN {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <16 17>;
        };

        COMBO_R_PARAN {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <17 18>;
        };

        COMBO_L_BRACKET {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <27 28>;
        };

        COMBO_R_BRACKET {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <28 29>;
        };

        COMBO_q {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <18 19>;
        };

        COMBO_GRAVE {
            bindings = <&kp GRAVE>;
            key-positions = <10 21>;
        };

        COMBO_EXC {
            bindings = <&kp EXCL>;
            key-positions = <0 10>;
        };

        COMBO_AT {
            bindings = <&kp AT_SIGN>;
            key-positions = <1 11>;
        };

        COMBO_POUND {
            bindings = <&kp POUND>;
            key-positions = <12 2>;
        };

        COMBO_DOLLAR {
            bindings = <&kp DOLLAR>;
            key-positions = <3 13>;
        };

        COMBO_PERCENT {
            bindings = <&kp PERCENT>;
            key-positions = <4 14>;
        };

        COMBO_CARET {
            bindings = <&kp CARET>;
            key-positions = <5 15>;
        };

        COMBO_END {
            bindings = <&kp AMPERSAND>;
            key-positions = <6 16>;
        };

        COMBO_STAR {
            bindings = <&kp STAR>;
            key-positions = <7 17>;
        };

        COMBO_MINUS {
            bindings = <&kp MINUS>;
            key-positions = <8 18>;
        };

        COMBO_EQUALS {
            bindings = <&kp EQUAL>;
            key-positions = <9 19>;
        };

        COMBO_BACKSLASH {
            bindings = <&kp BACKSLASH>;
            key-positions = <19 30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
        &kp Q              &kp W              &kp E                &kp R           &kp T          &kp Y        &kp U           &kp I                 &kp O               &kp P
        &HRM_L LEFT_GUI A  &HRM_L LEFT_ALT S  &HRM_L LEFT_SHIFT D  &HRM_L LCTRL F  &kp G          &kp H        &HRM_R RCTRL J  &HRM_R RIGHT_SHIFT K  &HRM_R RIGHT_ALT L  &HRM_R RIGHT_GUI SEMI
&trans  &kp Z              &kp X              &kp C                &kp V           &kp B          &kp N        &kp M           &kp COMMA             &kp DOT             &kp FSLH               &trans
                                              &tog 1               &trans          &lt 2 SPACE    &lt 1 ENTER  &trans          &tog 3
            >;
        };

        num_nav {
            bindings = <
        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3    &kp NUMBER_4  &kp NUMBER_5    &kp NUMBER_6    &kp NUMBER_7    &kp NUMBER_8  &kp NUMBER_9     &kp NUMBER_0
        &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_SHIFT  &kp LCTRL     &trans          &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans
&trans  &trans        &trans        &trans          &trans        &trans          &trans          &trans          &trans        &trans           &trans        &trans
                                    &tog 0          &trans        &lt 2 SPACE     &kp ENTER       &trans          &trans
            >;
        };

        fn {
            bindings = <
        &kp F1        &kp F2        &kp F3          &kp F4     &kp F5       &kp F6       &kp F7     &kp F8           &kp F9         &kp F10
        &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_SHIFT  &kp LCTRL  &kp F11      &kp F12      &kp RCTRL  &kp RIGHT_SHIFT  &kp RIGHT_ALT  &kp RIGHT_GUI
&trans  &trans        &trans        &trans          &trans     &trans       &trans       &trans     &trans           &trans         &trans         &trans
                                    &trans          &trans     &kp SPACE    &lt 1 ENTER  &trans     &trans
            >;
        };

        sys {
            bindings = <
        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR    &trans          &trans             &trans           &trans      &trans
        &trans        &trans        &trans        &trans        &trans        &kp C_PREVIOUS  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans          &trans             &trans           &trans      &trans  &trans
                                    &trans        &trans        &trans        &kp C_MUTE      &kp C_PLAY_PAUSE   &tog 0
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
