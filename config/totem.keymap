//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        HRM_L: HRM_L {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            require-prior-idle-ms = <175>;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 35 36 37>;
            hold-trigger-on-release;
        };

        HRM_R: HRM_R {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            flavor = "balanced";
            require-prior-idle-ms = <175>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34>;
        };
    };

    combos {
        compatible = "zmk,combos";

        COMBO_DEL {
            bindings = <&kp DEL>;
            key-positions = <1 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
                      &kp Q              &kp W              &kp E                &kp R           &kp T           &kp Y            &kp U           &kp I                 &kp O               &kp P
                      &HRM_L LEFT_GUI A  &HRM_L LEFT_ALT S  &HRM_L LEFT_SHIFT D  &HRM_L LCTRL F  &kp G           &kp H            &HRM_R RCTRL J  &HRM_R RIGHT_SHIFT K  &HRM_R RIGHT_ALT L  &HRM_R RIGHT_GUI SEMI
&mt K_CALCULATOR TAB  &kp Z              &kp X              &kp C                &kp V           &kp B           &kp N            &kp M           &kp COMMA             &kp DOT             &kp FSLH               &mt PRINTSCREEN SINGLE_QUOTE
                                                            &tog 1               &lt 2 SPACE     &lt 3 ESCAPE    &lt 1 BACKSPACE  &lt 4 ENTER     &tog 3
            >;
        };

        num_symb {
            bindings = <
           &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3    &kp NUMBER_4  &kp NUMBER_5        &kp NUMBER_6       &kp NUMBER_7  &kp NUMBER_8     &kp NUMBER_9   &kp NUMBER_0
           &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_SHIFT  &kp LCTRL     &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp RCTRL     &kp RIGHT_SHIFT  &kp RIGHT_ALT  &kp RIGHT_GUI
&kp GRAVE  &trans        &trans        &trans          &trans        &kp MINUS           &kp EQUAL          &trans        &trans           &trans         &trans         &kp BACKSLASH
                                       &tog 1          &kp K_CMENU   &trans              &trans             &trans        &trans
            >;
        };

        fn {
            bindings = <
        &kp F1        &kp F2        &kp F3          &kp F4     &kp F5     &kp F6   &kp F7     &kp F8           &kp F9         &kp F10
        &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_SHIFT  &kp LCTRL  &kp F11    &kp F12  &kp RCTRL  &kp RIGHT_SHIFT  &kp RIGHT_ALT  &kp RIGHT_GUI
&trans  &trans        &trans        &trans          &trans     &trans     &trans   &trans     &trans           &trans         &trans         &trans
                                    &trans          &trans     &trans     &trans   &trans     &trans
            >;
        };

        sys {
            bindings = <
        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR    &trans          &trans             &trans           &trans      &trans
        &trans        &trans        &trans        &trans        &trans        &kp C_PREVIOUS  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_NEXT  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans          &trans             &trans           &trans      &trans  &trans
                                    &trans        &trans        &trans        &kp C_MUTE      &kp C_PLAY_PAUSE   &tog 3
            >;
        };

        nav {
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans     &trans
        &trans  &trans  &trans  &trans  &trans    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans     &trans  &trans
                        &trans  &trans  &trans    &trans    &trans    &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
